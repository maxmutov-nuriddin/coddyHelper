# ====================================================
# coddyHelper — Telegram AI Yordamchisi (.env namunasi)
# ====================================================

# 1. Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+998901234567
TELEGRAM_STRING_SESSION=your_telethon_string_session_here

# 2. AI Modellar — Groq (Multi-key klaster) & Gemini Fallback
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 3. Guruh va Eskalyatsiya (Vazifalar guruhi ID si yoki 'me')
ESCALATION_CHAT=-5388159517

# 4. Asosiy Rejimlar va Boshqaruv
AUTO_REPLY_ENABLED=true
GROUP_REPLY_ENABLED=true
MENTOR_WAIT_SECONDS=5
COMMAND_PREFIX=.
MEMORY_LIMIT=10

# 5. Render.com Web Service Port
PORT=10000


# 6. Telegram Bot va Super Admin
BOT_TOKEN=123456:bot_token_here
BOT_USERNAME=coddyassistanstbot
MENTOR_USER_ID=8105823872

# 7. MongoDB Atlas (bulut xotira — mijoz bazalari snapshotlari ham shu yerda)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Agent
MONGODB_DB_NAME=CoddyAgentBrain

# 8. Multi-tenant xavfsizlik
# Mijozlarning Telegram HSS kodlarini shifrlash kaliti (Render va lokalda BIR XIL bo'lishi shart!
# O'zgartirilsa saqlangan sessiyalar ochilmaydi va mijozlar qayta ulanishi kerak bo'ladi)
SESSION_ENCRYPTION_KEY=uzun-tasodifiy-maxfiy-satr
# Mijoz sessiyalarini qaysi server yuritadi: auto (MongoDB lease, standart) | off (lokal dev uchun tavsiya) | force
CLIENT_SESSIONS_MODE=auto
# (Ixtiyoriy) Favqulodda Super Admin tokeni. Bo'sh qoldirilsa master token o'chiq bo'ladi.
MASTER_ADMIN_TOKEN=
# Bir serverdagi mijoz agentlari limiti (Render free ~512 MB uchun 12 tavsiya)
MAX_CLIENT_SESSIONS=12
# Telegram Stars orqali obuna sotish (0 = o'chiq) va obuna muddati (kun)
SUBSCRIPTION_STARS_PRICE=0
SUBSCRIPTION_DAYS=30
