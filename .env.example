# ====================================================
# coddyHelper — Telegram AI Yordamchisi (.env namunasi)
# ====================================================

# 1. Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+998901234567
TELEGRAM_STRING_SESSION=your_telethon_string_session_here

# 2. AI Modellar — Groq (Multi-key klaster) & Gemini Fallback
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 3. Guruh va Eskalyatsiya (Vazifalar guruhi ID si yoki 'me')
ESCALATION_CHAT=-5388159517

# 4. Asosiy Rejimlar va Boshqaruv
AUTO_REPLY_ENABLED=true
GROUP_REPLY_ENABLED=true
MENTOR_WAIT_SECONDS=5
COMMAND_PREFIX=.
MEMORY_LIMIT=10

# 5. Render.com Web Service Port
PORT=10000

