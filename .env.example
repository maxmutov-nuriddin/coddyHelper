# ====================================================
# Telegram Userbot Konfiguratsiyasi (coddyHelper)
# ====================================================

# Telegram API ma'lumotlari: https://my.telegram.org (API development tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+998901234567

# Google Gemini API kaliti: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Ishlatiladigan Gemini modeli (gemini-2.5-flash yoki gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Shaxsiy xabarlarga avtomatik javob berish (true / false)
AUTO_REPLY_ENABLED=true

# Foydalanuvchi buyruqlari prefiksi (masalan, .)
COMMAND_PREFIX=.

# Har bir chat uchun xotirada saqlanadigan xabarlar soni
MEMORY_LIMIT=10
